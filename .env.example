# ==============================================================================
# DeliveryOS — Master Environment Configuration (.env.example)
# ==============================================================================
# Single source of truth for ALL services (backend, portals, mobile dart-defines
# are separate). Usage: `cp .env.example .env` — .env is gitignored and holds
# real values. Do not create per-app .env files.

# Application Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Active region preset for business rules (BD | KSA). Consumed by
# backend region-time utilities (currency formatting lives in the clients).
REGION_MODE=BD

# PostgreSQL 16 + PostGIS Spatial Database
# Note: Host port is mapped to 5433 by default to avoid collisions with local Postgres
# REQUIRED: DATABASE_URL must be a literal URL (dotenv does not expand variables)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=secretpassword
DB_NAME=deliveryos
DATABASE_URL=postgresql://postgres:secretpassword@localhost:5433/deliveryos?schema=public

# Redis 7.2 Cache & Real-Time Pub/Sub
# Note: Host port is mapped to 6380 by default to avoid collisions with local Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@localhost:6380

# JWT Authentication & Tokens — both secrets are REQUIRED, minimum 32 characters.
# NEVER deploy with the example values: the dev secrets are rejected by the
# production config validation schema.
JWT_SECRET=deliveryos-jwt-secret-key-32chars-minimum-dev
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=deliveryos-refresh-secret-key-32chars-dev
JWT_REFRESH_EXPIRES_IN=30d

# SSLCommerz Payment Gateway (used when client requests gateway=SSLCOMMERZ).
# Production deploy requires the LIVE base URL — sandbox is rejected in prod.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_CALLBACK_BASE=http://localhost:4000

# Firebase Cloud Messaging (push) — inline service-account JSON or file path
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT=

# CORS whitelist (comma-separated origins; defaults to localhost dev origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# SMS & OTP Service ("mock" for local dev ONLY — production requires ssl_wireless)
# SMS_MOCK_STATIC_OTP and ALLOW_STATIC_OTP are FORBIDDEN when NODE_ENV=production.
# The SSL Wireless credentials are REQUIRED when SMS_PROVIDER=ssl_wireless.
SMS_PROVIDER=mock
SMS_MOCK_STATIC_OTP=123456
SMS_SSLW_API_TOKEN=
SMS_SSLW_SID=

# Google Maps Platform — consumed ONLY by the Flutter customer app via
# --dart-define (scripts/build-android.sh), not by the backend (geocoding is OSM).
GOOGLE_MAPS_API_KEY=

# Observability (optional) — enables Sentry error capture in backend + portals
# and Flutter apps (via dart-define) when set. Forward SENTRY_DSN in the prod
# compose environment to activate it in production.
SENTRY_DSN=

# Storage & Uploads — only the "local" driver is implemented; S3/R2 are
# rejected at runtime until delivered (future increment, needs an ADR).
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
