# ==============================================================================
# DeliveryOS — Master Environment Configuration (.env.example)
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Multi-Region & Localization Settings
# Active Mode: "BD" (Bangladesh) or "KSA" (Saudi Arabia)
REGION_MODE=BD

# Region Preset: Bangladesh (Active if REGION_MODE=BD)
BD_CURRENCY_CODE=BDT
BD_CURRENCY_SYMBOL=৳
BD_DEFAULT_LOCALE=en
BD_PHONE_PREFIX=+880
BD_DEFAULT_FLAT_FEE=50.00

# Region Preset: Saudi Arabia (Active if REGION_MODE=KSA)
KSA_CURRENCY_CODE=SAR
KSA_CURRENCY_SYMBOL=﷼
KSA_DEFAULT_LOCALE=ar
KSA_PHONE_PREFIX=+966
KSA_DEFAULT_FLAT_FEE=12.00

# PostgreSQL 16 + PostGIS Spatial Database
# Note: Host port is mapped to 5433 by default to avoid collisions with local Postgres
# REQUIRED: DATABASE_URL must be a literal URL (dotenv does not expand variables)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=secretpassword
DB_NAME=deliveryos
DATABASE_URL=postgresql://postgres:secretpassword@localhost:5433/deliveryos?schema=public

# Redis 7.2 Cache & Real-Time Pub/Sub
# Note: Host port is mapped to 6380 by default to avoid collisions with local Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@localhost:6380

# JWT Authentication & Tokens — both secrets are REQUIRED, minimum 32 characters
JWT_SECRET=deliveryos-jwt-secret-key-32chars-minimum-dev
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=deliveryos-refresh-secret-key-32chars-dev
JWT_REFRESH_EXPIRES_IN=30d

# CORS whitelist (comma-separated origins; defaults to localhost dev origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# SMS & OTP Service (Options: "mock" for local dev ONLY — production requires a real provider)
# SMS_MOCK_STATIC_OTP and ALLOW_STATIC_OTP are FORBIDDEN when NODE_ENV=production
SMS_PROVIDER=mock
SMS_MOCK_STATIC_OTP=123456

# Google Maps Platform (Geocoding & Places)
GOOGLE_MAPS_API_KEY=

# Storage & Uploads (Options: "local", "s3", "r2")
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
