# DeliveryOS TLS edge routing — rendered by the nginx image's envsubst
# mechanism from ${DOMAIN} (only defined environment variables are substituted;
# nginx runtime variables like $host pass through untouched).
#
# NOTE: This config assumes certificates already exist at
# /etc/letsencrypt/live/${DOMAIN}/ — see deploy/README.md for the first-boot
# issuance procedure (one-off certbot standalone run before starting nginx).

server {
    listen 80;
    server_name ${DOMAIN};

    # ACME HTTP-01 challenge for issuance and renewal
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 10m;

    # Dynamic Docker DNS resolution (10s TTL) prevents 502 Bad Gateway upon upstream restarts
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend_upstream http://backend:4000;
    set $vendor_portal_upstream http://vendor_portal:8080;
    set $admin_portal_upstream http://admin_portal:8080;

    # REST API
    location /api/ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Uploaded media (local storage driver)
    location /uploads/ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
    }

    # Socket.IO handshake path
    location /socket.io/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Long-lived WebSocket connections must survive idle periods; the
        # 60s nginx default silently drops KDS/fleet/tracking sockets.
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Realtime event namespace
    location /events/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Vendor Store & Kitchen Order Console KDS (subpath)
    location /vendor/ {
        proxy_pass $vendor_portal_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /vendor {
        return 301 /vendor/;
    }

    # Super Admin Master Console (default root)
    location / {
        proxy_pass $admin_portal_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
