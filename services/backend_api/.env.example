# ==============================================================================
# DeliveryOS — Backend API Environment Configuration (.env.example)
# ==============================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

REGION_MODE=BD
BD_CURRENCY_CODE=BDT
BD_CURRENCY_SYMBOL=৳
BD_DEFAULT_LOCALE=en
BD_PHONE_PREFIX=+880
BD_DEFAULT_FLAT_FEE=50.00

KSA_CURRENCY_CODE=SAR
KSA_CURRENCY_SYMBOL=﷼
KSA_DEFAULT_LOCALE=ar
KSA_PHONE_PREFIX=+966
KSA_DEFAULT_FLAT_FEE=12.00

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=secretpassword
DB_NAME=deliveryos
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@localhost:6380

# Both JWT secrets are REQUIRED, minimum 32 characters (validated at boot)
JWT_SECRET=deliveryos-jwt-secret-key-32chars-minimum-dev
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=deliveryos-refresh-secret-key-32chars-dev
JWT_REFRESH_EXPIRES_IN=30d

# CORS whitelist (comma-separated origins; defaults to localhost dev origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# SMS: "mock" is dev-only — SMS_MOCK_STATIC_OTP / ALLOW_STATIC_OTP are forbidden in production
SMS_PROVIDER=mock
SMS_MOCK_STATIC_OTP=123456
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
