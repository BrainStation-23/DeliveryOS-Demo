{
  "name": "@deliveryos/backend-api",
  "version": "0.1.0",
  "description": "DeliveryOS Enterprise Backend API with NestJS, PostgreSQL/PostGIS, and Prisma",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "jest",
    "test": "npm run test:unit && npm run db:test && npm run auth:test && npm run vendor:test && npm run promotions:test && npm run order:test && npm run vendor-rider:test && npm run ws:test && npm run dispatch:test && npm run tracking:test && npm run e2e:test && npm run health:test && npm run escalation:test && npm run payment:test && npm run address:test && npm run settlement:test && npm run cancel:test && npm run track1:test && npm run track3:test",
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed:massive": "ts-node prisma/seed-massive.ts",
    "db:test": "ts-node scripts/test-db.ts",
    "auth:test": "ts-node scripts/test-auth-rbac.ts",
    "vendor:test": "ts-node scripts/test-vendor-discovery.ts",
    "promotions:test": "ts-node scripts/test-promotions-pricing.ts",
    "order:test": "ts-node scripts/test-order-checkout.ts",
    "vendor-rider:test": "ts-node scripts/test-vendor-rider.ts",
    "ws:test": "ts-node scripts/test-websocket-tracking.ts",
    "dispatch:test": "ts-node scripts/test-order-dispatch-fsm.ts",
    "tracking:test": "ts-node scripts/test-live-tracking.ts",
    "e2e:test": "ts-node scripts/test-e2e-lifecycle.ts",
    "health:test": "ts-node scripts/test-health.ts",
    "escalation:test": "ts-node scripts/test-fcm-notifications.ts",
    "payment:test": "ts-node scripts/test-online-payments.ts",
    "address:test": "ts-node scripts/test-address-profile.ts",
    "settlement:test": "ts-node scripts/test-settlement-cycles.ts",
    "cancel:test": "ts-node scripts/test-order-cancellation.ts",
    "track1:test": "ts-node scripts/test-track-1-integrity.ts",
    "track3:test": "ts-node scripts/test-track-3-vendor-kds.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.2",
    "nest-winston": "^1.10.2",
    "pg": "^8.13.1",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
